# PDK gm/ID generation: fetched PDKs + staging, plus the generated tables themselves.
# The tables are large and fully reproducible with `tools/gen_gmid.py`, so they are not
# committed; the provenance notes + license text under data/pdk/ ARE tracked.
.pdk/
.pdkgen/
data/pdk/**/*.mostab.csv

# Local release staging (packaged dataset tarball + checksum + notes, ready to upload)
release/

# e2e demo fixtures (regenerated from the EKV oracle by web/e2e/global-setup.ts)
web/e2e/fixtures/demo.mostab.csv
web/e2e/fixtures/pmos-demo.mostab.csv

# ngspice init (ngbehavior=hsa so sectioned .lib works)
.spiceinit

# CodeGraphContext indexing sidecar (local dev tool, like ltspice-mcp above)
.cgcignore
